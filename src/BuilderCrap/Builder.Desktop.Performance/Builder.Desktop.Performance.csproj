<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <BuilderBinaryDirectory Condition="'$(BuilderBinaryDirectory)' == ''">$(MSBuildThisFileDirectory)../Builder.Desktop/bin/Release/net10.0-windows</BuilderBinaryDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="ScopeProgram.cs" />
    <Compile Remove="ExpandedGroupProgram.cs" />
    <None Include="Program.cs" CopyToOutputDirectory="PreserveNewest" />
    <Reference Include="Builder"><HintPath>$(BuilderBinaryDirectory)/Builder.dll</HintPath></Reference>
    <Reference Include="Builder.Core"><HintPath>$(BuilderBinaryDirectory)/Builder.Core.dll</HintPath></Reference>
  </ItemGroup>
</Project>
