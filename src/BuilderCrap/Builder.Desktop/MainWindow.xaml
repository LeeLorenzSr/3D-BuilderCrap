<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Builder.Desktop" x:Class="Builder.Desktop.MainWindow" Style="{DynamicResource {x:Type Window}}" Title="3D BuilderCrap" Icon="Assets/BuilderCrap.ico" Width="1280" Height="820" MinWidth="1040" MinHeight="720" WindowStartupLocation="CenterScreen" PreviewKeyDown="OnKeyDown" Closing="OnClosing">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Background="{DynamicResource ChromeFFFFFFFF}" Padding="14,6" Name="FileStrip">
      <DockPanel LastChildFill="False">
        <Button Name="HelpButton" DockPanel.Dock="Right" Content="Help" ToolTip="Help and version (F1)" AutomationProperties.Name="Help and version" Click="HelpClick" MinHeight="30" Padding="10,5"/>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
          <local:SvgIcon Key="app-mark" Width="26" Height="26" Margin="0,0,9,0"/>
          <TextBlock Text="3D BuilderCrap" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Name="Toolbar" Orientation="Horizontal">
          <Button Name="NewButton" local:Icon.Key="add" Content="_New" ToolTip="New empty scene (Ctrl+N)" Click="NewClick" MinHeight="30" Padding="10,5"/>
          <Menu Background="Transparent" VerticalAlignment="Center" Margin="0,0,6,0" KeyboardNavigation.TabNavigation="Continue">
            <MenuItem Name="RecentFilesMenu" Header="_Recent ▾" AutomationProperties.Name="Recent model files" Padding="8,7"/>
          </Menu>
          <Button local:Icon.Key="open" Content="Open…" ToolTip="Open STL, OBJ, PLY, glTF/GLB or 3MF (Ctrl+O)" AutomationProperties.Name="Open model" Click="OpenClick" MinHeight="30" Padding="10,5" />
          <Button local:Icon.Key="save" Name="SaveButton" Content="_Save" ToolTip="Save names and display materials as 3MF (Ctrl+S)" Click="SaveClick" MinHeight="30" Padding="10,5" />
          <Button local:Icon.Key="save-as" Name="SaveAsButton" Content="Save as…" ToolTip="Save scene as another 3MF (Ctrl+Shift+S)" Click="SaveAsClick" MinHeight="30" Padding="10,5" />
          <Button local:Icon.Key="export" Name="ExportButton" Content="Export…" ToolTip="Export all objects as STL geometry, OBJ, PLY or glTF/GLB with supported display colors; save 3MF to keep model information" Click="ExportClick" MinHeight="30" Padding="10,5" />
          <Border Width="1" Background="{DynamicResource Line}" Margin="6,4,12,4" />
          <Button local:Icon.Key="undo" Name="UndoButton" Content="Undo" ToolTip="Undo scene edit (Ctrl+Z)" Style="{StaticResource QuietButton}" Click="UndoClick" MinHeight="30" Padding="10,5" />
          <Button local:Icon.Key="redo" Name="RedoButton" Content="Redo" ToolTip="Redo scene edit (Ctrl+Y)" Style="{StaticResource QuietButton}" Click="RedoClick" MinHeight="30" Padding="10,5" />
        </StackPanel>
      </DockPanel>
    </Border>
    <TabControl Name="WorkspaceTabs" Grid.Row="1" SelectionChanged="WorkspaceTabChanged" Style="{StaticResource WorkspaceTabControl}" AutomationProperties.Name="Workspace commands" SelectedIndex="0">
      <TabItem Name="InsertWorkspaceTab" Header="_Insert" AutomationProperties.Name="Insert workspace">
        <Border Background="{DynamicResource ChromeF8FAFB}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="14,7,14,9">
          <StackPanel Name="InsertCommands" Orientation="Horizontal" MinHeight="72">
            <StackPanel Margin="0,0,16,0">
              <Menu Background="#00FFFFFF" VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Continue" AutomationProperties.Name="Add primitive" HorizontalAlignment="Left" Margin="0,0,0,3">
                <FrameworkElement.Resources>
                  <ResourceDictionary>
                    <Style x:Key="{x:Type MenuItem}" TargetType="{x:Type MenuItem}">
                      <Setter Property="Padding" Value="10,8" />
                    </Style>
                  </ResourceDictionary>
                </FrameworkElement.Resources>
                <MenuItem Name="AddShapeMenu" Header="_Shapes ▾" ToolTip="Add a primitive to the scene" AutomationProperties.Name="Add shape menu" Background="Transparent" BorderBrush="{DynamicResource Line}" BorderThickness="0" Padding="2,1" MinHeight="18">
                  <MenuItem Header="Cube" AutomationProperties.Name="Add cube" Click="AddCubeClick" ><MenuItem.Icon><local:SvgIcon Key="cube" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
                  <MenuItem Header="Cylinder" AutomationProperties.Name="Add cylinder" Click="AddCylinderClick" ><MenuItem.Icon><local:SvgIcon Key="cylinder" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
                  <MenuItem Header="Sphere" AutomationProperties.Name="Add sphere" Click="AddSphereClick" ><MenuItem.Icon><local:SvgIcon Key="sphere" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
                  <MenuItem Header="Pyramid" Tag="Pyramid" Click="AddShapeClick" ><MenuItem.Icon><local:SvgIcon Key="pyramid" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
                  <MenuItem Header="Cone" Tag="Cone" Click="AddShapeClick" ><MenuItem.Icon><local:SvgIcon Key="cone" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
                  <MenuItem Header="Hexagon" Tag="Hexagon" Click="AddShapeClick" ><MenuItem.Icon><local:SvgIcon Key="hexagon" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
                  <MenuItem Header="Wedge" Tag="Wedge" Click="AddShapeClick" ><MenuItem.Icon><local:SvgIcon Key="wedge" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
                  <MenuItem Header="Torus" Tag="Torus" Click="AddShapeClick" ><MenuItem.Icon><local:SvgIcon Key="torus" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
                  <MenuItem Header="Tetrahedron" Tag="Tetrahedron" Click="AddShapeClick" ><MenuItem.Icon><local:SvgIcon Key="tetrahedron" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
                  <Separator />
                  <MenuItem Header="New text…" Click="NewTextClick" AutomationProperties.Name="Create new text" ><MenuItem.Icon><local:SvgIcon Key="text" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
                  <MenuItem Header="Image…" Click="ImageReliefClick" AutomationProperties.Name="Convert an image to relief contour edge or stamp" ><MenuItem.Icon><local:SvgIcon Key="image-relief" Width="18" Height="18"/></MenuItem.Icon></MenuItem>
                </MenuItem>
              </Menu>
              <UniformGrid Name="InsertShapePalette" Columns="9" Width="666">
                <Button Name="PaletteCubeButton" Tag="Cube" Click="AddShapeClick" Style="{StaticResource ShapePaletteButton}" AutomationProperties.Name="Create cube" Content="Cube" local:Icon.Key="cube"/>
                <Button Name="PaletteCylinderButton" Tag="Cylinder" Click="AddShapeClick" Style="{StaticResource ShapePaletteButton}" AutomationProperties.Name="Create cylinder" Content="Cylinder" local:Icon.Key="cylinder"/>
                <Button Name="PalettePyramidButton" Tag="Pyramid" Click="AddShapeClick" Style="{StaticResource ShapePaletteButton}" AutomationProperties.Name="Create pyramid" Content="Pyramid" local:Icon.Key="pyramid"/>
                <Button Name="PaletteConeButton" Tag="Cone" Click="AddShapeClick" Style="{StaticResource ShapePaletteButton}" AutomationProperties.Name="Create cone" Content="Cone" local:Icon.Key="cone"/>
                <Button Name="PaletteSphereButton" Tag="Sphere" Click="AddShapeClick" Style="{StaticResource ShapePaletteButton}" AutomationProperties.Name="Create sphere" Content="Sphere" local:Icon.Key="sphere"/>
                <Button Name="PaletteHexagonButton" Tag="Hexagon" Click="AddShapeClick" Style="{StaticResource ShapePaletteButton}" AutomationProperties.Name="Create hexagon" Content="Hexagon" local:Icon.Key="hexagon"/>
                <Button Name="PaletteWedgeButton" Tag="Wedge" Click="AddShapeClick" Style="{StaticResource ShapePaletteButton}" AutomationProperties.Name="Create wedge" Content="Wedge" local:Icon.Key="wedge"/>
                <Button Name="PaletteTorusButton" Tag="Torus" Click="AddShapeClick" Style="{StaticResource ShapePaletteButton}" AutomationProperties.Name="Create torus" Content="Torus" local:Icon.Key="torus"/>
                <Button Name="PaletteTetrahedronButton" Tag="Tetrahedron" Click="AddShapeClick" Style="{StaticResource ShapePaletteButton}" AutomationProperties.Name="Create tetrahedron" Content="Tetrahedron" local:Icon.Key="tetrahedron"/>
              </UniformGrid>
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Create / import" FontSize="11" Foreground="{DynamicResource MutedInk}" Margin="0,0,0,4" />
              <StackPanel Orientation="Horizontal">
                <Button local:Icon.Key="text" Name="NewTextButton" Content="Text…" Click="NewTextClick" Style="{StaticResource RibbonCommandButton}" />
                <Button local:Icon.Key="image-relief" Name="ImageReliefButton" Content="Image…" Click="ImageReliefClick" Style="{StaticResource RibbonCommandButton}" />
                <Button local:Icon.Key="insert" Name="InsertButton" Content="Insert file…" ToolTip="Add STL, OBJ, PLY, glTF/GLB or 3MF objects into the current scene" AutomationProperties.Name="Insert models into scene" Click="InsertClick" Style="{StaticResource RibbonCommandButton}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>
      </TabItem>
      <TabItem Name="ObjectWorkspaceTab" Header="_Object" AutomationProperties.Name="Object workspace">
        <Border Background="{DynamicResource ChromeF8FAFB}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="14,7,14,9">
          <StackPanel Name="ObjectCommands" Orientation="Horizontal" MinHeight="72">
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Transform" FontSize="11" Foreground="{DynamicResource MutedInk}" Margin="0,0,0,4" />
              <StackPanel Name="HandleTools" Orientation="Horizontal" AutomationProperties.Name="Transform tools">
                <Button local:Icon.Key="move" Name="MoveHandleButton" Content="Move" Style="{StaticResource RibbonCommandButton}" ToolTip="Move on world axes. Drag an axis handle and release to preview." AutomationProperties.Name="Move handles" Click="MoveHandleClick" />
                <Button local:Icon.Key="rotate" Name="RotateHandleButton" Content="Rotate" Style="{StaticResource RibbonCommandButton}" ToolTip="Rotate around world axes. Drag a rotation handle and release to preview." AutomationProperties.Name="Rotation handles" Click="RotateHandleClick" />
                <Button local:Icon.Key="scale" Name="ScaleHandleButton" Content="Scale" Style="{StaticResource RibbonCommandButton}" ToolTip="Scale on world axes. Drag an axis handle and release to preview." AutomationProperties.Name="Scale handles" Click="ScaleHandleClick" />
                <Button local:Icon.Key="bed" Name="BedButton" Content="Place on bed" Click="BedClick" Style="{StaticResource RibbonCommandButton}" />
              </StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button local:Icon.Key="align" Name="CenterOnPlateButton" Content="Center on plate…" Click="CenterOnPlateClick" ToolTip="Center selected objects, groups or members on world X=0, Y=0" MinHeight="28" Padding="8,4" Margin="0,0,4,0"/>
                <Button local:Icon.Key="duplicate" Name="RadialArrayButton" Content="Radial array…" Click="RadialArrayClick" ToolTip="Repeat the selected set around a world-axis pivot" MinHeight="28" Padding="8,4"/>
              </StackPanel>
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Organize" FontSize="11" Foreground="{DynamicResource MutedInk}" Margin="0,0,0,4" />
              <StackPanel Name="EditActions" Orientation="Horizontal">
                <Button local:Icon.Key="duplicate" Name="DuplicateButton" Content="Duplicate" ToolTip="Duplicate selected objects and groups (Ctrl+D)" Click="DuplicateClick" MinHeight="28" Padding="8,4" Margin="0,0,4,0" />
                <Button local:Icon.Key="duplicate" Name="ArrayButton" Content="Array…" ToolTip="Preview a rectangular array of the selected objects, groups or members" Click="ArrayClick" MinHeight="28" Padding="8,4" Margin="0,0,4,0" />
                <Button local:Icon.Key="delete" Name="DeleteButton" Content="Delete" ToolTip="Delete selected objects and groups (Delete)" Click="DeleteClick" MinHeight="28" Padding="8,4" Margin="0,0,4,0" />
                <Button local:Icon.Key="edit-members" Name="EditMembersButton" Content="Edit members…" Margin="0,0,4,0" Padding="8,4" ToolTip="Select and edit individual members while preserving their group" AutomationProperties.Name="Edit selected group members" Click="EnterGroupClick" MinHeight="28" />
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <Button local:Icon.Key="group" Name="GroupButton" Content="Group…" ToolTip="Review grouping selected objects; meshes remain separate" Click="GroupClick" MinHeight="28" Padding="9,4" />
                <Button local:Icon.Key="ungroup" Name="UngroupButton" Content="Ungroup…" ToolTip="Review making group members independent" Click="UngroupClick" MinHeight="28" Padding="9,4" />
                <Button local:Icon.Key="align" Name="AlignButton" Content="Align…" ToolTip="Align selected objects or groups on world axes" Click="AlignClick" MinHeight="28" Padding="9,4" />
                <Button local:Icon.Key="align" Name="DistributeButton" Content="Distribute…" ToolTip="Evenly space at least three selected objects, groups or members" Click="DistributeClick" MinHeight="28" Padding="9,4" />
              </StackPanel>
            </StackPanel>
            <Border Name="EditActionsDivider" Height="58" Background="{DynamicResource Line}" Width="1" Margin="0,7,14,0" />
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Inspect" FontSize="11" Foreground="{DynamicResource MutedInk}" Margin="0,0,0,4" />
              <StackPanel Name="InspectionTools" Orientation="Horizontal">
                <Button local:Icon.Key="mirror" Name="MirrorButton" Content="Mirror…" ToolTip="Preview a reflection of the selected objects or members across a world plane" Click="MirrorClick" Style="{StaticResource RibbonCommandButton}" />
                <Button local:Icon.Key="measure" Name="MeasureButton" Content="Measure" ToolTip="Pick two surface points to measure a distance in millimeters" Click="MeasureClick" Style="{StaticResource RibbonCommandButton}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>
      </TabItem>
      <TabItem Name="EditWorkspaceTab" Header="_Edit" AutomationProperties.Name="Edit workspace">
        <Border Background="{DynamicResource ChromeF8FAFB}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="14,7,14,9">
          <StackPanel Name="EditCommands" Orientation="Horizontal" MinHeight="72">
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Mesh operations" FontSize="11" Foreground="{DynamicResource MutedInk}" Margin="0,0,0,4" />
              <Grid Name="ConstructionTools">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button local:Icon.Key="split" Name="SplitButton" Content="Split…" ToolTip="Cut an object with a plane" Click="SplitClick" Style="{StaticResource RibbonCommandButton}" Grid.Column="0" />
                <Button local:Icon.Key="combine" Name="CombineButton" Content="Combine…" ToolTip="Union, subtract or intersect two objects. The result uses operand A’s material." Click="CombineClick" Style="{StaticResource RibbonCommandButton}" Grid.Column="1" />
                <Button local:Icon.Key="repair" Name="RepairButton" Content="Repair…" ToolTip="Check mesh problems and preview a repair" Click="RepairClick" Style="{StaticResource RibbonCommandButton}" Grid.Column="2" />
                <Button local:Icon.Key="hollow" x:Name="HollowButton" Content="Hollow…" ToolTip="Preview a sealed cavity with a requested minimum wall thickness" Click="HollowClick" Style="{StaticResource RibbonCommandButton}" Grid.Column="3" />
                <Button local:Icon.Key="simplify" x:Name="SimplifyButton" Content="Simplify…" Click="SimplifyClick" ToolTip="Reduce triangles within an explicit maximum surface deviation" Style="{StaticResource RibbonCommandButton}" Grid.Column="4" />
                <Button local:Icon.Key="smooth" x:Name="SmoothButton" Content="Smooth…" Click="SmoothClick" ToolTip="Smooth the surface within an explicit maximum shape deviation" Style="{StaticResource RibbonCommandButton}" Grid.Column="5" />
                <Button local:Icon.Key="emboss" x:Name="EmbossButton" Content="Emboss…" Click="EmbossClick" ToolTip="Raise or engrave planar text on one selected object or group member" Style="{StaticResource RibbonCommandButton}" Grid.Column="6" />
                <Button local:Icon.Key="separate" x:Name="SeparateButton" Content="Separate…" Click="SeparateClick" ToolTip="Make disconnected material pieces individually editable without moving them" Style="{StaticResource RibbonCommandButton}" Grid.Column="7" />
                <Button local:Icon.Key="extrude-down" x:Name="ExtrudeDownButton" Content="Extrude down…" Click="ExtrudeDownClick" ToolTip="Extend the selected solid straight down to a horizontal plane" Style="{StaticResource RibbonCommandButton}" Grid.Column="8"/>
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>
      </TabItem>
      <TabItem Name="PaintWorkspaceTab" Header="_Paint" AutomationProperties.Name="Paint workspace">
        <Border Background="{DynamicResource ChromeF8FAFB}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="14,7,14,9">
          <StackPanel Name="PaintCommands" Orientation="Horizontal" MinHeight="72">
            <StackPanel Margin="0,0,20,0">
              <TextBlock Text="Display color" FontSize="11" Foreground="{DynamicResource MutedInk}" Margin="0,0,0,4"/>
              <StackPanel Orientation="Horizontal">
                <Button Name="MaterialButton" Content="Material…" local:Icon.Key="material" Click="MaterialClick" Style="{StaticResource RibbonCommandButton}" ToolTip="Preview a display color on selected objects, groups or members"/>
                <Button Name="SurfaceMaterialButton" Content="Surface…" local:Icon.Key="paint" Click="SurfaceMaterialClick" Style="{StaticResource RibbonCommandButton}" ToolTip="Click a connected flat surface to preview its color"/>
                <Button Name="BrushMaterialButton" Content="Brush…" local:Icon.Key="paint" Click="BrushMaterialClick" Style="{StaticResource RibbonCommandButton}" ToolTip="Paint surface triangles with several brush strokes before Apply"/>
              </StackPanel>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Name="MaterialSelectionSummary" MaxWidth="670" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontWeight="SemiBold" Margin="0,0,0,5"/>
              <TextBlock Text="3MF keeps names and display colors. Assign print materials in your slicer." Foreground="{DynamicResource MutedInk}" FontSize="12"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </TabItem>
      <TabItem Name="ViewWorkspaceTab" Header="_View" AutomationProperties.Name="View workspace">
        <Border Background="{DynamicResource ChromeF8FAFB}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="14,7,14,9">
          <StackPanel Name="ViewCommands" MinHeight="72">
            <StackPanel Orientation="Horizontal">
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Camera" FontSize="11" Foreground="{DynamicResource MutedInk}" Margin="0,0,0,4" />
              <StackPanel Orientation="Horizontal" Name="CameraTools">
                <Button local:Icon.Key="view-isometric" Content="Isometric" Style="{StaticResource RibbonCommandButton}" ToolTip="Isometric view" Click="ViewIsometricClick" Name="ViewIsometricButton" />
                <Button local:Icon.Key="view-top" Content="Top" Style="{StaticResource RibbonCommandButton}" ToolTip="Look down the Z axis" Click="ViewTopClick" Name="ViewTopButton" />
                <Button local:Icon.Key="view-front" Content="Front" Style="{StaticResource RibbonCommandButton}" Click="ViewFrontClick" Name="ViewFrontButton" />
                <Button local:Icon.Key="view-right" Content="Right" Style="{StaticResource RibbonCommandButton}" Click="ViewRightClick" Name="ViewRightButton" />
                <Border Width="1" Background="{DynamicResource EdgeC9D3DB}" Margin="5,5,9,5" />
                <Button local:Icon.Key="fit-selection" Content="Fit selection" Style="{StaticResource RibbonCommandButton}" ToolTip="Frame all selected objects and groups" Click="FitSelectionClick" Name="FitSelectionButton" />
                <Button local:Icon.Key="fit-scene" Content="Fit scene" ToolTip="Frame the whole scene (F)" Click="FitClick" Name="FitSceneButton" Style="{StaticResource RibbonCommandButton}" />
              </StackPanel>
            </StackPanel>
            <StackPanel Margin="16,0,0,0">
              <TextBlock Text="Display" FontSize="11" Foreground="{DynamicResource MutedInk}" Margin="0,0,0,4"/>
              <Grid Name="DisplayTools">
                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="115"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <CheckBox Name="ViewGrid" Content="Grid" IsChecked="True" Checked="ViewSettingsChanged" Unchecked="ViewSettingsChanged" ToolTip="Show the build grid" AutomationProperties.Name="Show grid"/>
                <CheckBox Name="ViewColors" Grid.Column="1" Content="Colors" IsChecked="True" Checked="ViewSettingsChanged" Unchecked="ViewSettingsChanged" ToolTip="Show assigned object and face colors" AutomationProperties.Name="Show assigned colors"/>
                <CheckBox Name="ViewWireframe" Grid.Row="1" Content="Wireframe" Checked="ViewSettingsChanged" Unchecked="ViewSettingsChanged" ToolTip="Show actual triangle edges over shaded surfaces" AutomationProperties.Name="Show triangle wireframe"/>
                <CheckBox Name="ViewXRay" Grid.Row="1" Grid.Column="1" Content="X-ray" Checked="ViewSettingsChanged" Unchecked="ViewSettingsChanged" ToolTip="Make surfaces translucent to inspect inside" AutomationProperties.Name="Show X-ray transparency"/>
                <CheckBox Name="ViewShadows" Grid.Row="2" Content="Shadows" IsChecked="True" Checked="ViewSettingsChanged" Unchecked="ViewSettingsChanged" ToolTip="Cast display-only shadows onto the build plane. Meshes and saved files stay unchanged." AutomationProperties.Name="Show build-plate shadows"/>
                <CheckBox Name="ViewReflections" Grid.Row="2" Grid.Column="1" Content="Reflections" Checked="ViewSettingsChanged" Unchecked="ViewSettingsChanged" ToolTip="Show a subdued display-only reflection below the build plane. Meshes and saved files stay unchanged." AutomationProperties.Name="Show build-plate reflections"/>
              </Grid>
            </StackPanel>
            <StackPanel Margin="16,0,0,0">
              <TextBlock Text="Shading" FontSize="11" Foreground="{DynamicResource MutedInk}" Margin="0,0,0,4"/>
              <RadioButton Name="ViewShadingFlat" Content="Flat" GroupName="ViewShading" IsChecked="True" Checked="ViewShadingChanged" MinHeight="26" ToolTip="Display only: show each triangle's face normal. Mesh unchanged." AutomationProperties.Name="Flat display shading"/>
              <RadioButton Name="ViewShadingSmooth" Content="Smooth" GroupName="ViewShading" Checked="ViewShadingChanged" MinHeight="26" ToolTip="Display only: average normals at coincident corners. Mesh unchanged." AutomationProperties.Name="Smooth display shading"/>
            </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
              <Button Name="ResetDisplayButton" Content="Reset display" local:Icon.Key="undo" Click="ResetDisplayClick" Style="{StaticResource QuietButton}" MinHeight="28" Padding="8,4" ToolTip="Restore and remember defaults: grid, colors and shadows on; wireframe, X-ray and reflections off; flat shading. Camera unchanged."/>
              <Border Width="1" Background="{DynamicResource Line}" Margin="7,2,14,2"/>
              <Button Name="AboutModelButton" Content="About this model…" local:Icon.Key="info" Click="AboutModelClick" Style="{StaticResource QuietButton}" MinHeight="28" Padding="8,4" ToolTip="Edit document-wide title, designer, description and attribution"/>
              <Button Name="RecoverButton" Content="Recover unsaved work…" local:Icon.Key="undo" Click="RecoverClick" Style="{StaticResource QuietButton}" MinHeight="28" Padding="8,4" ToolTip="Review recovery copies left by previous sessions"/>
              <Button Name="McpAccessButton" Content="MCP access…" Click="McpAccessClick" Style="{StaticResource QuietButton}" MinHeight="28" Padding="8,4" ToolTip="Enable or stop trusted local MCP clients for this window" AutomationProperties.Name="Local MCP access"/>
              <TextBlock Name="ViewPreferenceHelp" Text="View choices are remembered. Reset saves defaults; camera unchanged." FontSize="11" Foreground="{DynamicResource MutedInk}" VerticalAlignment="Center" Margin="16,0,0,0" MaxWidth="420" TextWrapping="Wrap"/>
            </StackPanel>
            <Border Name="ViewPreferenceWarning" Visibility="Collapsed" Background="{DynamicResource ChromeFFF4DB}" BorderBrush="{DynamicResource EdgeD9B66F}" BorderThickness="1" Padding="8,4" Margin="0,6,0,0">
              <DockPanel LastChildFill="True">
                <Button Name="SaveViewChoicesButton" DockPanel.Dock="Right" Content="Save view choices" Click="SaveViewChoicesClick" Style="{StaticResource QuietButton}" MinHeight="26" Padding="8,3" Margin="12,0,0,0" ToolTip="Save the display choices currently in use. This does not reload the preferences file."/>
                <local:AccessibleStatusText x:Name="ViewPreferenceWarningText" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource WarningInk}" AutomationProperties.LiveSetting="Polite"/>
              </DockPanel>
            </Border>
          </StackPanel>
        </Border>
      </TabItem>
    </TabControl>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="330" />
      </Grid.ColumnDefinitions>
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="{DynamicResource ChromeF8FAFB}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="18,10">
          <DockPanel>
            <StackPanel>
              <TextBlock Name="SceneTitle" Text="Untitled scene" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
              <TextBlock Name="SceneSummary" Foreground="{DynamicResource MutedInk}" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>
        <local:SceneViewport x:Name="ViewportSurface" Grid.Row="1" Background="{DynamicResource ChromeEDF1F4}" ClipToBounds="True" Focusable="True" AutomationProperties.Name="3D scene viewport" AutomationProperties.HelpText="Select objects in the Objects list and use Object tools for numeric editing. Press F to fit the scene." MouseDown="ViewportDown" MouseMove="ViewportMove" MouseUp="ViewportUp" MouseWheel="ViewportWheel" LostMouseCapture="ViewportLostCapture">
          <Grid>
            <Viewport3D Name="Viewport" ClipToBounds="True" IsHitTestVisible="False" />
            <Border Name="DisplayNotice" Background="{DynamicResource ChromeEEF8FAFB}" BorderBrush="{DynamicResource EdgeC9D3DB}" BorderThickness="1" Padding="8,5" Margin="12" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False">
              <TextBlock Text="Assigned colors are hidden. Turn on Colors to review paint." FontSize="12" TextWrapping="Wrap" MaxWidth="290"/>
            </Border>
            <Canvas Name="BrushCursorOverlay" IsHitTestVisible="False" ClipToBounds="True" ToolTip="Approximate brush diameter at the last painted surface depth"/>
            <Canvas Name="MaterialSelectionOverlay" ClipToBounds="True" IsHitTestVisible="False" AutomationProperties.Name="Selected painted object bounds"/>
            <Canvas Name="TransformOverlay" ClipToBounds="True" IsHitTestVisible="False" AutomationProperties.Name="Transform handles" />
