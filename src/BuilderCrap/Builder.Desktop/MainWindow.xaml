                          <ColumnDefinition />
                          <ColumnDefinition />
                          <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,7,0">
                          <TextBlock Text="X" FontSize="12" Margin="0,0,0,5" />
                          <TextBox Name="PositionX" AutomationProperties.Name="Position X in millimeters" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,7,0">
                          <TextBlock Text="Y" FontSize="12" Margin="0,0,0,5" />
                          <TextBox Name="PositionY" AutomationProperties.Name="Position Y in millimeters" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                          <TextBlock Text="Z" FontSize="12" Margin="0,0,0,5" />
                          <TextBox Name="PositionZ" AutomationProperties.Name="Position Z in millimeters" />
                        </StackPanel>
                      </Grid>
                      <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button local:Icon.Key="preview" Content="Preview move" Style="{StaticResource PrimaryButton}" Click="MoveClick" />
                      </StackPanel>
                      <Button local:Icon.Key="reset" Name="MoveResetButton" Content="Reset fields" HorizontalAlignment="Left" Style="{StaticResource QuietButton}" Margin="0,6,0,0" Click="ResetClick" />
                    </StackPanel>
                  </TabItem>
                  <TabItem Header="Rotate">
                    <StackPanel>
                      <TextBlock Text="Relative rotation · degrees" Foreground="{DynamicResource MutedInk}" Margin="0,0,0,10" />
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition />
                          <ColumnDefinition />
                          <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,7,0">
                          <TextBlock Text="X" FontSize="12" Margin="0,0,0,5" />
                          <TextBox Name="RotationX" Text="0" AutomationProperties.Name="Relative rotation X in degrees" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,7,0">
                          <TextBlock Text="Y" FontSize="12" Margin="0,0,0,5" />
                          <TextBox Name="RotationY" Text="0" AutomationProperties.Name="Relative rotation Y in degrees" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                          <TextBlock Text="Z" FontSize="12" Margin="0,0,0,5" />
                          <TextBox Name="RotationZ" Text="0" AutomationProperties.Name="Relative rotation Z in degrees" />
                        </StackPanel>
                      </Grid>
                      <TextBlock Text="Rotate around the selection center, in X → Y → Z order on world axes." FontSize="12" Foreground="{DynamicResource MutedInk}" Margin="0,10,0,12" />
                      <StackPanel Orientation="Horizontal">
                        <Button local:Icon.Key="preview" Content="Preview rotation" Style="{StaticResource PrimaryButton}" Click="RotateClick" />
                        <Button local:Icon.Key="reset" Name="RotationResetButton" Content="Reset" Click="ResetClick" />
                      </StackPanel>
                    </StackPanel>
                  </TabItem>
                </TabControl>
                <StackPanel Name="HandleSettings" Margin="0,18,0,0">
                  <Border Height="1" Background="{DynamicResource Line}" Margin="0,0,0,12" />
                  <CheckBox Name="SnapTransforms" Content="Snap transforms" IsChecked="True" AutomationProperties.Name="Snap transforms" Checked="TransformSettingsChanged" Unchecked="TransformSettingsChanged" />
                  <DockPanel Margin="0,6,0,0" LastChildFill="False">
                    <TextBlock Text="Step" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBox Name="SnapStep" Text="1" Width="80" AutomationProperties.Name="Transform snap step" TextChanged="TransformSettingsChanged" />
                    <TextBlock Name="SnapUnit" Text="mm" VerticalAlignment="Center" Foreground="{DynamicResource MutedInk}" Margin="8,0,0,0" />
                  </DockPanel>
                  <CheckBox Name="UniformScale" Content="Scale all axes with a handle" IsChecked="True" Visibility="Collapsed" Margin="0,8,0,0" AutomationProperties.Name="Uniform handle scale" Checked="TransformSettingsChanged" Unchecked="TransformSettingsChanged" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
          <Border Name="MaterialActions" Grid.Row="2" Background="{DynamicResource ChromeF6F9FB}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="18,14,18,16" Visibility="Collapsed">
            <StackPanel>
              <CheckBox Name="MaterialShowOriginal" Content="Show original" Checked="MaterialOriginalChanged" Unchecked="MaterialOriginalChanged" Margin="0,0,0,8" AutomationProperties.Name="Compare original material with preview"/>
              <TextBlock Name="MaterialSummary" FontSize="12" Foreground="{DynamicResource MutedInk}" LineHeight="18" Margin="0,0,0,12"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button Name="PreviewMaterialButton" Content="Preview" local:Icon.Key="preview" Click="PreviewMaterialClick"/>
                <Button Name="ApplyMaterialButton" Grid.Column="1" Content="Apply" local:Icon.Key="apply" Click="ApplyMaterialClick" IsEnabled="False" Style="{StaticResource PrimaryButton}"/>
                <Button Name="CancelMaterialButton" Grid.Column="2" Content="Cancel" local:Icon.Key="cancel" Click="CancelMaterialClick" Margin="0"/>
              </Grid>
            </StackPanel>
          </Border>
          <Border x:Name="ExtrudeDownActions" Grid.Row="2" Background="{DynamicResource ChromeF6F9FB}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="18,14,18,16" Visibility="Collapsed">
            <StackPanel>
              <CheckBox x:Name="ExtrudeDownShowOriginal" Content="Show original" Checked="ExtrudeDownOriginalChanged" Unchecked="ExtrudeDownOriginalChanged" Margin="0,0,0,8" AutomationProperties.Name="Compare original object with extruded result"/>
              <TextBlock x:Name="ExtrudeDownSummary" FontSize="12" Foreground="{DynamicResource MutedInk}" LineHeight="18" Margin="0,0,0,12"/>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button local:Icon.Key="preview" x:Name="PreviewExtrudeDownButton" Content="Preview" Click="PreviewExtrudeDownClick" AutomationProperties.Name="Preview extrusion down to the target plane"/>
                <Button local:Icon.Key="apply" x:Name="ApplyExtrudeDownButton" Grid.Column="1" Content="Apply" Click="ApplyExtrudeDownClick" IsEnabled="False" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Apply reviewed downward extrusion"/>
                <Button local:Icon.Key="cancel" x:Name="CancelExtrudeDownButton" Grid.Column="2" Content="Cancel" Click="CancelExtrudeDownClick" Margin="0" AutomationProperties.Name="Cancel downward extrusion"/>
              </Grid>
            </StackPanel>
          </Border>
          <Border x:Name="SeparateActions" Grid.Row="2" Background="{DynamicResource ChromeF6F9FB}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="18,14,18,16" Visibility="Collapsed">
            <StackPanel>
              <CheckBox x:Name="SeparateShowOriginal" Content="Show original" Checked="SeparateViewChanged" Unchecked="SeparateViewChanged" Margin="0,0,0,8" AutomationProperties.Name="Compare original object with separated pieces" />
              <TextBlock x:Name="SeparateSummary" FontSize="12" Foreground="{DynamicResource MutedInk}" LineHeight="18" Margin="0,0,0,12" />
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button local:Icon.Key="preview" x:Name="PreviewSeparateButton" Content="Preview" Click="PreviewSeparateClick" AutomationProperties.Name="Preview separation into editable objects" />
                <Button local:Icon.Key="apply" x:Name="ApplySeparateButton" Grid.Column="1" Content="Apply" Click="ApplySeparateClick" IsEnabled="False" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Apply all separated pieces" />
                <Button local:Icon.Key="cancel" x:Name="CancelSeparateButton" Grid.Column="2" Content="Cancel" Click="CancelSeparateClick" Margin="0" AutomationProperties.Name="Cancel separation" />
              </Grid>
            </StackPanel>
          </Border>
          <Border x:Name="SmoothActions" Grid.Row="2" Background="{DynamicResource ChromeF6F9FB}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="18,14,18,16" Visibility="Collapsed">
            <StackPanel>
              <CheckBox x:Name="SmoothShowOriginal" Content="Show original" Checked="SmoothOriginalChanged" Unchecked="SmoothOriginalChanged" Margin="0,0,0,8" AutomationProperties.Name="Compare original object with smoothed result" />
              <TextBlock x:Name="SmoothLimitNotice" Text="Movement limited by the shape limit." Foreground="{DynamicResource LimitInk}" FontSize="12" LineHeight="18" Margin="0,0,0,12" Visibility="Collapsed" />
              <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="SmoothSummary" FontSize="12" Foreground="{DynamicResource MutedInk}" LineHeight="18" Margin="0,0,0,12" />
              </ScrollViewer>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button local:Icon.Key="preview" x:Name="PreviewSmoothButton" Content="Preview" Click="PreviewSmoothClick" AutomationProperties.Name="Preview smoothing" />
                <Button local:Icon.Key="apply" x:Name="ApplySmoothButton" Grid.Column="1" Content="Apply" Click="ApplySmoothClick" IsEnabled="False" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Apply reviewed smoothing" />
                <Button local:Icon.Key="cancel" x:Name="CancelSmoothButton" Grid.Column="2" Content="Cancel" Click="CancelSmoothClick" Margin="0" AutomationProperties.Name="Cancel smoothing" />
              </Grid>
            </StackPanel>
          </Border>
          <Border x:Name="SimplifyActions" Grid.Row="2" Background="{DynamicResource ChromeF6F9FB}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="18,14,18,16" Visibility="Collapsed">
            <StackPanel>
              <CheckBox x:Name="SimplifyShowOriginal" Content="Show original" Checked="SimplifyOriginalChanged" Unchecked="SimplifyOriginalChanged" Margin="0,0,0,8" AutomationProperties.Name="Compare original object with simplified result" />
              <TextBlock x:Name="SimplifyTargetNotice" Text="Target not reached. Apply keeps this smaller reduction." Foreground="{DynamicResource LimitInk}" FontSize="12" LineHeight="18" Margin="0,0,0,12" Visibility="Collapsed" />
              <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                <TextBlock x:Name="SimplifySummary" FontSize="12" Foreground="{DynamicResource MutedInk}" LineHeight="18" />
              </ScrollViewer>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button local:Icon.Key="preview" x:Name="PreviewSimplifyButton" Content="Preview" Click="PreviewSimplifyClick" AutomationProperties.Name="Preview simplification" />
                <Button local:Icon.Key="apply" x:Name="ApplySimplifyButton" Grid.Column="1" Content="Apply" Click="ApplySimplifyClick" IsEnabled="False" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Apply reviewed simplification" />
                <Button local:Icon.Key="cancel" x:Name="CancelSimplifyButton" Grid.Column="2" Content="Cancel" Click="CancelSimplifyClick" Margin="0" AutomationProperties.Name="Cancel simplification" />
              </Grid>
            </StackPanel>
          </Border>
          <Border x:Name="HollowActions" Grid.Row="2" Background="{DynamicResource ChromeF6F9FB}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="18,14,18,16" Visibility="Collapsed">
            <StackPanel>
              <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                <TextBlock x:Name="HollowSummary" FontSize="12" Foreground="{DynamicResource MutedInk}" LineHeight="18" />
              </ScrollViewer>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button local:Icon.Key="preview" x:Name="PreviewHollowButton" Content="Preview" Click="PreviewHollowClick" AutomationProperties.Name="Preview hollow shell" />
                <Button local:Icon.Key="apply" x:Name="ApplyHollowButton" Grid.Column="1" Content="Apply" Click="ApplyHollowClick" IsEnabled="False" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Apply reviewed sealed hollow shell" />
                <Button local:Icon.Key="cancel" x:Name="CancelHollowButton" Grid.Column="2" Content="Cancel" Click="CancelHollowClick" Margin="0" AutomationProperties.Name="Cancel hollow" />
              </Grid>
            </StackPanel>
          </Border>
          <Border x:Name="ImageReliefActions" Grid.Row="2" Background="{DynamicResource ChromeF6F9FB}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="18,14,18,16" Visibility="Collapsed">
            <StackPanel>
              <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                <TextBlock x:Name="ImageReliefSummary" FontSize="12" Foreground="{DynamicResource MutedInk}" LineHeight="18" />
              </ScrollViewer>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button local:Icon.Key="preview" x:Name="PreviewImageReliefButton" Content="Preview" Click="PreviewImageReliefClick" AutomationProperties.Name="Preview image conversion" />
                <Button local:Icon.Key="add" x:Name="AddImageReliefButton" Grid.Column="1" Content="Add" Click="AddImageReliefClick" IsEnabled="False" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Add reviewed image relief" Padding="7,7" />
                <Button local:Icon.Key="cancel" x:Name="CancelImageReliefButton" Grid.Column="2" Content="Cancel" Click="CancelImageReliefClick" Margin="0" AutomationProperties.Name="Cancel image conversion" />
              </Grid>
            </StackPanel>
          </Border>
          <Border x:Name="TextToolActions" Grid.Row="2" Background="{DynamicResource ChromeF6F9FB}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="18,14,18,16" Visibility="Collapsed">
            <StackPanel>
              <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                <TextBlock x:Name="TextToolSummary" FontSize="12" Foreground="{DynamicResource MutedInk}" LineHeight="18" />
              </ScrollViewer>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button local:Icon.Key="preview" x:Name="PreviewTextButton" Content="Preview" Click="PreviewTextClick" AutomationProperties.Name="Preview text" />
                <Button local:Icon.Key="apply" x:Name="ApplyTextButton" Grid.Column="1" Content="Apply" Click="ApplyTextClick" IsEnabled="False" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Accept reviewed text" />
                <Button local:Icon.Key="cancel" x:Name="CancelTextButton" Grid.Column="2" Content="Cancel" Click="CancelTextClick" Margin="0" AutomationProperties.Name="Cancel text tool" />
              </Grid>
            </StackPanel>
          </Border>
          <Border Name="MirrorActions" Grid.Row="2" Background="{DynamicResource ChromeF6F9FB}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="18,14,18,16" Visibility="Collapsed">
            <StackPanel>
              <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                <TextBlock Name="MirrorSummary" FontSize="12" Foreground="{DynamicResource MutedInk}" LineHeight="18" />
              </ScrollViewer>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button local:Icon.Key="preview" Name="PreviewMirrorButton" Content="Preview" AutomationProperties.Name="Preview mirror" Click="PreviewMirrorClick" />
                <Button local:Icon.Key="apply" Name="ApplyMirrorButton" Grid.Column="1" Content="Apply" IsEnabled="False" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Apply mirror preview" Click="ApplyMirrorClick" />
                <Button local:Icon.Key="cancel" Name="CancelMirrorButton" Grid.Column="2" Content="Cancel" Margin="0" AutomationProperties.Name="Cancel mirror" Click="CancelMirrorClick" />
              </Grid>
            </StackPanel>
          </Border>
          <Border Name="MeasurementActions" Grid.Row="2" Background="{DynamicResource ChromeF6F9FB}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="18,14,18,16" Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
              </Grid.ColumnDefinitions>
              <Button local:Icon.Key="reset" Name="ResetMeasurementButton" Content="Reset" AutomationProperties.Name="Reset measured points" Click="ResetMeasurementClick" />
              <Button local:Icon.Key="apply" Name="DoneMeasurementButton" Grid.Column="1" Content="Done" Margin="0" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Finish measurement" Click="DoneMeasurementClick" />
            </Grid>
          </Border>
          <Border Name="PrimitiveActions" Grid.Row="2" Background="{DynamicResource ChromeF6F9FB}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="18,14,18,16" Visibility="Collapsed">
            <StackPanel>
              <TextBlock Text="Minimum X/Y/Z: 0 mm · may overlap existing objects" FontSize="12" Foreground="{DynamicResource MutedInk}" Margin="0,0,0,8" />
              <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                <TextBlock Name="PrimitiveSummary" FontSize="12" Foreground="{DynamicResource MutedInk}" LineHeight="18" />
              </ScrollViewer>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button local:Icon.Key="preview" Name="PreviewPrimitiveButton" Content="Preview" AutomationProperties.Name="Preview new shape" Click="PreviewPrimitiveClick" />
                <Button local:Icon.Key="add" Name="AddPrimitiveButton" Grid.Column="1" Content="Add" IsEnabled="False" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Add reviewed shape" Click="AddPrimitiveClick" />
                <Button local:Icon.Key="cancel" Name="CancelPrimitiveButton" Grid.Column="2" Content="Cancel" Margin="0" AutomationProperties.Name="Cancel shape creation" Click="CancelPrimitiveClick" />
              </Grid>
            </StackPanel>
          </Border>
          <Border Name="ConstructionActions" Grid.Row="2" Background="{DynamicResource ChromeF6F9FB}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="18,14,18,16" Visibility="Collapsed">
            <StackPanel>
              <CheckBox Name="ShowOriginal" Content="Show original" Visibility="Collapsed" Margin="0,0,0,8" Checked="OriginalChanged" Unchecked="OriginalChanged" />
              <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                <TextBlock Name="ConstructionSummary" Text="Preview the result before applying it." Foreground="{DynamicResource MutedInk}" FontSize="12" LineHeight="18" />
              </ScrollViewer>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button local:Icon.Key="preview" Name="PreviewButton" Content="Preview" AutomationProperties.Name="Preview construction result" Click="PreviewClick" />
                <Button local:Icon.Key="apply" Name="ApplyPreviewButton" Grid.Column="1" Content="Apply" IsEnabled="False" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Apply preview" Click="ApplyPreviewClick" />
                <Button local:Icon.Key="cancel" Grid.Column="2" Content="Cancel" Margin="0" AutomationProperties.Name="Cancel construction" Click="CancelConstructionClick" />
              </Grid>
            </StackPanel>
          </Border>
          <Border Name="TransformActions" Grid.Row="2" Background="{DynamicResource ChromeF6F9FB}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="18,14,18,16" Visibility="Collapsed">
            <StackPanel>
              <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                <TextBlock Name="TransformSummary" Text="Preview a transform before applying it." Foreground="{DynamicResource MutedInk}" FontSize="12" LineHeight="18" />
              </ScrollViewer>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button local:Icon.Key="preview" Name="PreviewTransformButton" Content="Preview" AutomationProperties.Name="Preview transform" Click="PreviewTransformClick" />
                <Button local:Icon.Key="apply" Name="ApplyTransformButton" Grid.Column="1" Content="Apply" IsEnabled="False" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Apply transform preview" Click="ApplyTransformClick" />
                <Button local:Icon.Key="cancel" Name="CancelTransformButton" Grid.Column="2" Content="Cancel" Margin="0" AutomationProperties.Name="Cancel transform preview" Click="CancelTransformClick" />
              </Grid>
            </StackPanel>
          </Border>
          <Border Name="ArrangementActions" Grid.Row="2" Background="{DynamicResource ChromeF6F9FB}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="18,14,18,16" Visibility="Collapsed">
            <StackPanel>
              <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                <TextBlock Name="ArrangementSummary" Text="Preview this arrangement before applying it." Foreground="{DynamicResource MutedInk}" FontSize="12" LineHeight="18" />
              </ScrollViewer>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button local:Icon.Key="preview" Name="PreviewArrangementButton" Content="Preview" AutomationProperties.Name="Preview arrangement" Click="PreviewArrangementClick" />
                <Button local:Icon.Key="apply" Name="ApplyArrangementButton" Grid.Column="1" Content="Apply" IsEnabled="False" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Apply arrangement preview" Click="ApplyArrangementClick" />
                <Button local:Icon.Key="cancel" Name="CancelArrangementButton" Grid.Column="2" Content="Cancel" Margin="0" AutomationProperties.Name="Cancel arrangement" Click="CancelArrangementClick" />
              </Grid>
            </StackPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>
    <Border Name="McpPreviewActions" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="330" Background="{DynamicResource ChromeF6F9FB}" BorderBrush="{DynamicResource Line}" BorderThickness="1,1,0,0" Padding="18,14" Visibility="Collapsed">
      <StackPanel>
        <TextBlock Text="MCP preview" FontWeight="SemiBold"/>
        <ScrollViewer MaxHeight="90" VerticalScrollBarVisibility="Auto" Margin="0,7,0,10"><TextBlock Name="McpPreviewSummary" TextWrapping="Wrap" FontSize="12"/></ScrollViewer>
        <UniformGrid Columns="2">
          <Button Name="ApplyMcpPreviewButton" Content="Apply" Style="{StaticResource PrimaryButton}" Click="ApplyMcpPreviewClick" AutomationProperties.Name="Apply MCP preview"/>
          <Button Name="CancelMcpPreviewButton" Content="Cancel" Click="CancelMcpPreviewClick" AutomationProperties.Name="Cancel MCP preview"/>
        </UniformGrid>
      </StackPanel>
    </Border>
    <Border Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Background="{DynamicResource ChromeFFFFFFFF}" Padding="18,8">
      <DockPanel MinHeight="34">
        <Button local:Icon.Key="cancel" Name="CancelOperation" Content="Cancel operation" DockPanel.Dock="Right" Visibility="Collapsed" Margin="12,0,0,0" Click="CancelClick" />
        <ProgressBar Name="Progress" Width="100" Height="4" DockPanel.Dock="Right" Margin="14,0,0,0" IsIndeterminate="True" Visibility="Collapsed" AutomationProperties.Name="Operation progress" />
        <StackPanel VerticalAlignment="Center">
          <local:AccessibleStatusText x:Name="Status" Text="Ready. All dimensions are in millimeters." FontSize="12" MinHeight="20" AutomationProperties.LiveSetting="Polite" />
          <local:AccessibleStatusText x:Name="RecoveryWarning" Text="Recovery copy could not be saved. Save your work normally." Visibility="Collapsed" TextWrapping="Wrap" Foreground="{DynamicResource ErrorInk}" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
