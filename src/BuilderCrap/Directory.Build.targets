<Project>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../../LICENSE" Link="LICENSE.txt"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(OutputType)' == 'Exe' or '$(OutputType)' == 'WinExe'">
    <None Include="$(MSBuildThisFileDirectory)Builder.GeometryWorker\bin\win-x64\**\*" Link="%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
