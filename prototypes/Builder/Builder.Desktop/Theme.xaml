<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Builder.Desktop">
  <ResourceDictionary.MergedDictionaries><local:AccessiblePalette/></ResourceDictionary.MergedDictionaries>
  <Style x:Key="KeyboardFocus" TargetType="Control">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Control"><Border BorderBrush="{DynamicResource Accent}" BorderThickness="2" Margin="-3" CornerRadius="3"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Window">
   <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="13"/>
   <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource ChromeF6F7F8}"/>
   <Setter Property="UseLayoutRounding" Value="True"/><Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
  </Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="local:AccessibleStatusText" BasedOn="{StaticResource {x:Type TextBlock}}"/>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="11,7"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="MinHeight" Value="34"/>
   <Setter Property="Background" Value="{DynamicResource ChromeFFFFFF}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="Button">
     <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
      <StackPanel x:Name="LabelLayout" Orientation="Horizontal" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
       <local:SvgIcon x:Name="Glyph" Key="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(local:Icon.Key)}" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </StackPanel>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="local:Icon.Key" Value="{x:Null}"><Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/></Trigger>
      <Trigger Property="local:Icon.Stacked" Value="True">
       <Setter TargetName="LabelLayout" Property="Orientation" Value="Vertical"/>
       <Setter TargetName="Glyph" Property="Width" Value="24"/><Setter TargetName="Glyph" Property="Height" Value="24"/>
       <Setter TargetName="Glyph" Property="Margin" Value="0,0,0,4"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource HoverInk}"/><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverECF2F6}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Edge8BA8BB}"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter Property="Foreground" Value="{DynamicResource HoverInk}"/><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverDCE8EF}"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledInk}"/><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource DisabledF5F6F7}"/><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource DisabledE1E5E8}"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource AccentText}"/><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource HoverInk}"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style x:Key="CameraButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Padding" Value="9,5"/><Setter Property="MinHeight" Value="30"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,4,0"/>
  </Style>
  <Style x:Key="HandleButton" TargetType="Button" BasedOn="{StaticResource CameraButton}">
   <Setter Property="Padding" Value="12,5"/>
  </Style>
  <Style x:Key="RibbonCommandButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="local:Icon.Stacked" Value="True"/>
   <Setter Property="MinWidth" Value="76"/><Setter Property="MinHeight" Value="54"/><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,0,4,0"/>
   <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style x:Key="ShapePaletteButton" TargetType="Button" BasedOn="{StaticResource RibbonCommandButton}">
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="MinWidth" Value="0"/><Setter Property="MinHeight" Value="54"/><Setter Property="Padding" Value="4,5"/>
  </Style>

  <Style TargetType="TextBox">
   <Setter Property="Padding" Value="8,7"/><Setter Property="MinHeight" Value="34"/>
   <Setter Property="BorderBrush" Value="{DynamicResource EdgeB9C5CE}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Background" Value="{DynamicResource ChromeFFFFFF}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Style.Triggers>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="BorderThickness" Value="2"/><Setter Property="Padding" Value="7,6"/></Trigger>
    <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource DisabledF4F6F7}"/><Setter Property="Foreground" Value="{DynamicResource DisabledInk}"/><Setter Property="BorderBrush" Value="{DynamicResource DisabledDEE4E8}"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="ComboBox"><Setter Property="MinHeight" Value="34"/><Setter Property="Padding" Value="8,6"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/></Style>
  <Style TargetType="CheckBox"><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="26"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/></Style>
  <Style TargetType="ListBox">
   <Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Background" Value="{DynamicResource ChromeFAFBFC}"/><Setter Property="Padding" Value="3"/>
   <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
  </Style>
  <Style TargetType="ListBoxItem">
   <Setter Property="Padding" Value="9,7"/><Setter Property="MinHeight" Value="34"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Row" Background="Transparent" CornerRadius="2" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource HoverInk}"/><Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverEDF1F4}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectionBackground}"/><Setter Property="Foreground" Value="{DynamicResource SelectionInk}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledInk}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabControl">
   <Setter Property="Background" Value="{DynamicResource ChromeFFFFFF}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="Padding" Value="0,16,0,0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
    <Grid Background="{TemplateBinding Background}" KeyboardNavigation.TabNavigation="Local"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
     <Border Grid.Row="1" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,1,0,0" Padding="{TemplateBinding Padding}"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></Border>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabItem">
   <Setter Property="FontWeight" Value="Normal"/>
   <Setter Property="Padding" Value="17,9"/><Setter Property="Foreground" Value="{DynamicResource MutedInk}"/><Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocus}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
    <Border x:Name="Tab" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}"><ContentPresenter x:Name="TabHeader" ContentSource="Header" RecognizesAccessKey="True" TextElement.FontWeight="Normal"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource HoverInk}"/><Setter TargetName="Tab" Property="Background" Value="{DynamicResource HoverF0F4F6}"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Tab" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter TargetName="TabHeader" Property="TextElement.FontWeight" Value="SemiBold"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource DisabledInk}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="WorkspaceTabControl" TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
   <Setter Property="Padding" Value="0"/>
  </Style>
</ResourceDictionary>
