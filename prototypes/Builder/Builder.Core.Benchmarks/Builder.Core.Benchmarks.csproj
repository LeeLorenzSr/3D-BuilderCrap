<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <BuilderCoreAssembly Condition="'$(BuilderCoreAssembly)' == ''">$(MSBuildThisFileDirectory)..\Builder.Core\bin\Release\net10.0\Builder.Core.dll</BuilderCoreAssembly>
  </PropertyGroup>
  <!-- Deliberately no ProjectReference: a frozen baseline must never rebuild product code. -->
  <ItemGroup><Reference Include="Builder.Core"><HintPath>$(BuilderCoreAssembly)</HintPath></Reference></ItemGroup>
</Project>
